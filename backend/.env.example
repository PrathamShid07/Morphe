# Copy to backend/.env and adjust. No API keys are needed: embeddings run locally and summaries are extractive.
# Real secrets (e.g. an authenticated MongoDB URI) belong ONLY in backend/.env, which is git-ignored.

# --- application -------------------------------------------------------------
APP_ENV=development            # development | test | production (production disables admin/demo endpoints)
API_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # explicit origins; "*" is refused in production
MAX_REQUEST_BYTES=2000000
DEBUG_TRACE_ENABLED=true
ALLOW_ADMIN_ENDPOINTS=true     # demo reset/seed/scenario + budget override; ignored (disabled) in production

# --- authentication / roles (see docs/ACCESS_CONTROL.md) ----------------------
# Do NOT put a password or hash here. Run `python backend/scripts/admin_credentials.py init`: it writes ADMIN_PASSWORD_HASH and SESSION_SECRET
# to the git-ignored backend/.env and prints the generated password once. Without a hash administrator sign-in is disabled.
ADMIN_USERNAME=morphe-admin
ADMIN_PASSWORD_HASH=           # generated by the script (Argon2id); leave empty here
SESSION_SECRET=                # generated by the script (>= 32 chars); required in production
ADMIN_SESSION_TTL_MINUTES=480
USER_SESSION_TTL_DAYS=30
# SESSION_COOKIE_SECURE=true   # default: Secure cookies whenever APP_ENV is not development
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
USER_TOP_K_MAX=20
USER_HISTORY_LIMIT=20

# --- user accounts and personal memory (see docs/USER_ACCOUNTS.md) -------------
REGISTRATION_ENABLED=true      # public sign-up; always creates a regular user, never an administrator
PASSWORD_MIN_LENGTH=10
REGISTER_MAX_PER_HOUR=20
USER_MEMORY_MAX_CHARS=20000
USER_MEMORY_MAX_RECORDS=5000
USER_COACCESS_MIN_COUNT=3
QDRANT_USER_MEMORY_COLLECTION=morphe_user_memories
QDRANT_USER_MODULE_COLLECTION=morphe_user_module_profiles
AUDIT_RETENTION_DAYS=365       # 0 = keep the audit log forever
AUDIT_QUERY_TEXT_CHARS=300     # how much of a submitted question the audit log keeps (disclosed in the privacy notice)
AUTO_MIGRATE=true              # label pre-account records on the shared plane at startup (idempotent)

# --- embeddings (local Sentence Transformers) ---------------------------------
EMBEDDING_BACKEND=sentence_transformers   # "hashing" is a test-only fake and is refused in production
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384        # must match the model AND the Qdrant collections

# --- Qdrant -------------------------------------------------------------------
QDRANT_MODE=local              # local (persistent folder, SINGLE worker only) | memory | server
QDRANT_LOCAL_PATH=../data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_MEMORY_COLLECTION=morphe_memories
QDRANT_MODULE_COLLECTION=morphe_module_profiles

# --- MongoDB ------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=morphe

# --- ingestion ----------------------------------------------------------------
MAX_INGEST_CHARS=1000000
CHUNK_MAX_TOKENS=200           # model wordpieces
CHUNK_OVERLAP_TOKENS=25
MODULE_ASSIGN_THRESHOLD=0.45

# --- retrieval ----------------------------------------------------------------
TOP_K_DEFAULT=5
SEED_MODULE_COUNT=3
MAX_CANDIDATE_MODULES=8
PER_MODULE_CANDIDATES=15
FALLBACK_ENABLED=true
FALLBACK_MIN_SCORE=0.30

# --- compression (active-text TOKEN budget, not RAM) --------------------------
MEMORY_BUDGET_TOKENS=100000
COMPRESSION_START_PCT=75
EMERGENCY_CLEANUP_PCT=90
CLEANUP_TARGET_PCT=82
COMPRESSION_TARGET_PCT=70      # normal jobs stop once usage is at or below this
MIN_SUMMARY_SAVING_PCT=15
COMPRESSION_COOLDOWN_SECONDS=30
COMPRESSION_MODE=background    # inline | background | off
NEAR_DUPLICATE_SIMILARITY=0.97
SUMMARY_GROUP_MIN_SIZE=3
SUMMARY_GROUP_SIMILARITY=0.55

# --- structural adaptation ----------------------------------------------------
ADAPTATION_QUERY_BATCH=50
AUTO_ADAPTATION=true
ADAPTATION_AUTO_APPLY=true     # false: detect + evaluate only, apply manually from the Adaptation Center
ADAPTATION_MAX_OPS_PER_WINDOW=1
SPLIT_CAPACITY_THRESHOLD=1000
SPLIT_MIXED_MIN_RECORDS=16
SPLIT_MIN_GROUP_SIZE=4
SPLIT_MAX_GROUPS=4
SPLIT_MIN_SILHOUETTE=0.08
SPLIT_MIXED_MIN_SILHOUETTE=0.10
MERGE_PROFILE_SIMILARITY=0.85
MERGE_PAIR_SIMILARITY=0.85
MERGE_OVERLAP_MIN=0.30
MERGE_MAX_CONFLICTS=0
COACCESS_MIN_COUNT=10
COACCESS_MIN_WINDOW_QUERIES=20
MAX_EDGES_TOTAL=60
MAX_COACCESS_PER_NODE=4

# --- evaluation & acceptance policy -------------------------------------------
EVAL_DATASET_PATH=../data/evaluation_queries.json
EVAL_TOP_K=5
EVAL_REPETITIONS=3
MIN_EVAL_QUERIES=10
MAX_RECALL_REGRESSION=0.02     # absolute
MAX_MRR_REGRESSION=0.02        # absolute
MAX_P95_LATENCY_REGRESSION_PCT=10
LATENCY_NOISE_FLOOR_MS=1.0     # sub-millisecond differences are measurement noise, not regressions
ALLOW_VALIDATION_OVERRIDE=false   # development only; can ONLY bypass "insufficient evaluation data", never regressions or integrity
POST_COMMIT_VERIFICATION=true

# --- demo ---------------------------------------------------------------------
SAMPLES_DIR=../data/samples
REPLAY_QUERIES_PATH=../data/demo_replay_queries.json
